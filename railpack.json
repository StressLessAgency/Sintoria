{
  "$schema": "https://schema.railpack.com",
  "providers": ["node"],
  "packages": {
    "node": "20"
  },
  "steps": {
    "install": {
      "commands": [
        "cd server && npm install"
      ]
    },
    "build": {
      "commands": [
        "cd server && npx prisma generate"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd server && npx prisma migrate deploy && (npm run db:seed || echo 'seed failed, continuing') && node src/app.js"
  }
}
